# All variables are required. The app fails to start if any are missing or invalid.
NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<db>?schema=public

# Firebase (auth + Firestore): full service account JSON as a single-line string
# (Firebase console → Project settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100

# Autonomous agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AGENT_MAX_ITERATIONS=50
AGENT_TOOL_TIMEOUT_SECONDS=120

# E2B cloud sandboxes (one isolated microVM per agent run)
E2B_API_KEY=
E2B_SANDBOX_TIMEOUT_SECONDS=3600

# Redis (queue, pub/sub events, distributed rate limiting, caching)
# Use rediss:// for TLS connections
REDIS_URL=redis://:<password>@localhost:6379

# Agent run queue worker concurrency per instance
AGENT_QUEUE_CONCURRENCY=5

# Membership authorization cache TTL
MEMBERSHIP_CACHE_TTL_SECONDS=30

# Swagger API docs at /api/docs (disable in production unless needed)
ENABLE_API_DOCS=false
