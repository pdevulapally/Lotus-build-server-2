rules_version = '2';

// All writes go through the backend Admin SDK (which bypasses these rules).
// Reads mirror the API's session isolation: regular MEMBERs may only read
// documents belonging to sessions they created; OWNER/ADMIN may read all
// documents in their organization. Membership documents are maintained by
// the backend.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function memberPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }

    function canReadPrivate(orgId, sessionCreatorId) {
      return isSignedIn()
        && exists(memberPath(orgId))
        && (get(memberPath(orgId)).data.role != 'MEMBER'
          || get(memberPath(orgId)).data.userId == sessionCreatorId);
    }

    match /agentRuns/{runId} {
      allow read: if canReadPrivate(
        resource.data.organizationId,
        resource.data.sessionCreatorId
      );
      allow write: if false;

      match /steps/{stepId} {
        allow read: if canReadPrivate(
          get(/databases/$(database)/documents/agentRuns/$(runId)).data.organizationId,
          get(/databases/$(database)/documents/agentRuns/$(runId)).data.sessionCreatorId
        );
        allow write: if false;
      }
    }

    match /sessions/{sessionId}/messages/{messageId} {
      allow read: if canReadPrivate(
        resource.data.organizationId,
        resource.data.sessionCreatorId
      );
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
